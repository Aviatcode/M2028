{
  "manifest_version": 3,
  "name": "M2028 - Productivity Hub & Screen Time Tracker",
  "short_name": "M2028",
  "version": "2.0.0",
  "description": "Monitors where you spend time most. One-stop stopwatch, clock, notes scratchpad, countdown timer, and quick search hub.",
  "icons": {
    "16": "favicon-32.png",
    "32": "favicon-32.png",
    "48": "icon-192.png",
    "128": "icon-192.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "favicon-32.png",
      "32": "favicon-32.png",
      "48": "icon-192.png",
      "128": "icon-192.png"
    },
    "default_title": "M2028 Productivity Hub"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms",
    "notifications",
    "offscreen",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://aviatcode.github.io/M2028/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://aviatcode.github.io/M2028/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Open M2028 Productivity Hub"
    },
    "open_full_planner": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Open M2028 Full Master Planner"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "popup.html",
        "popup.css",
        "popup.js",
        "content.js",
        "options.html",
        "options.css",
        "options.js",
        "blocked.html",
        "blocked.js",
        "leaf-icons.css",
        "stickers.js",
        "pom-duo.webp",
        "sussurus1.mp3",
        "icon-192.png",
        "icon-512.png",
        "favicon-32.png",
        "apple-touch-icon.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}